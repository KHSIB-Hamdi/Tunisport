# Tunisport — Symfony environment template
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real credentials.
# Symfony loads, in increasing order of precedence:
#   .env  ->  .env.local  ->  .env.$APP_ENV  ->  .env.$APP_ENV.local  ->  real environment variables

###> symfony/framework-bundle ###
# "dev" (local development), "test" (PHPUnit) or "prod".
# NOTE: StripeService switches to the *_LIVE Stripe keys whenever APP_ENV is not "dev".
APP_ENV=dev
# Random 32-character hex string. Generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change_me_to_a_random_32_char_hex_string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# The Java desktop client hardcodes the database name `tunisport` on localhost:3306 —
# keep the database name in sync with Java/src/Utils/DataBase.java.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/tunisport?serverVersion=8.0"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Required: config/packages/messenger.yaml references this variable and the app will not
# boot without it. The Doctrine transport needs no extra infrastructure.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/debug-bundle ###
# Required in the dev environment: config/packages/debug.yaml uses this in `dump_destination`.
# It is missing from the committed `.env`; see docs/AUDIT.md.
VAR_DUMPER_SERVER=127.0.0.1:9912
###< symfony/debug-bundle ###

###> Google OAuth (knpuniversity/oauth2-client-bundle + league/oauth2-google) ###
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
###< Google OAuth ###

###> Facebook OAuth (league/oauth2-facebook) ###
# Create an app at https://developers.facebook.com/apps
OAUTH_FACEBOOK_ID=your-facebook-app-id
OAUTH_FACEBOOK_SECRET=your-facebook-app-secret
###< Facebook OAuth ###

###> symfony/mailer ###
# Any Symfony Mailer DSN. Mailtrap example:
#   smtp://USERNAME:PASSWORD@sandbox.smtp.mailtrap.io:2525
MAILER_DSN=smtp://MAIL_USER:MAIL_PASSWORD@smtp.example.com:2525
###< symfony/mailer ###

###> stripe/stripe-php ###
# Test keys from https://dashboard.stripe.com/test/apikeys — used when APP_ENV=dev.
STRIPE_PUBLIC_KEY_TEST=pk_test_your_stripe_test_publishable_key
STRIPE_SECRET_KEY_TEST=sk_test_your_stripe_test_secret_key
# Live keys — used whenever APP_ENV is NOT "dev". Leave blank unless deploying for real.
STRIPE_PUBLIC_KEY_LIVE=
STRIPE_SECRET_KEY_LIVE=
###< stripe/stripe-php ###

###> Giphy (ChatBotController) ###
# NOT read from the environment today: the key is hardcoded in
# src/Controller/ChatBotController.php. Listed here so the dependency is visible.
# GIPHY_API_KEY=your-giphy-api-key
###< Giphy ###
